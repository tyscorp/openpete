# The 16:9 row is the contrast leg.
summer_forest | pos=(106616, 79875, 36925) yaw=-1522 pitch=154
summer_forest@aspect32x9 | pos=(106616, 79875, 36925) yaw=-1522 pitch=154 | | --aspect 32:9
