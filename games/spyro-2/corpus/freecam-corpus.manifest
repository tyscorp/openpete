zephyr@sv-frustum | pos=(150534, 57763, 12276) yaw=760 pitch=159 | | --sector-visibility frustum
zephyr@sv-filled | pos=(150534, 57763, 12276) yaw=760 pitch=159 | | --sector-visibility filled
